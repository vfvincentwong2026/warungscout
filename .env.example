# ============================================================
# WarungScout 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# 敏感信息请勿提交到 Git 仓库！
# ============================================================

# ---------- Cloudflare 配置 ----------
# 从 Cloudflare Dashboard 获取
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_ZONE_ID=your_zone_id

# ---------- Google Maps 抓取配置 ----------
# 方案一：SerpApi（推荐 MVP 阶段）
# 注册地址: https://serpapi.com/
# 免费额度: 100次/月
SERPAPI_API_KEY=your_serpapi_api_key

# 方案二：Google Places API（正式生产环境推荐）
# 启用 Places API: https://console.cloud.google.com/
# 需启用结算，有 200美元/月 免费额度
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# 方案三：Playwright 自建爬虫（无需 API Key）
# 需要配置代理池（可选）
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# ---------- 数据库配置 ----------
# D1 数据库 ID（从 wrangler.toml 或 Cloudflare Dashboard 获取）
D1_DATABASE_ID=your_d1_database_id

# 本地 SQLite 路径（开发环境）
LOCAL_DB_PATH=./data/warungscout.db

# ---------- JWT 认证配置 ----------
# 生成方式: openssl rand -base64 32
JWT_SECRET_KEY=your_jwt_secret_key_32_bytes_minimum
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ---------- 应用配置 ----------
APP_ENVIRONMENT=development  # development | preview | production
APP_DEBUG=true
LOG_LEVEL=INFO

# ---------- 前端配置 ----------
# 前端 API 基础 URL
VITE_API_BASE_URL=http://localhost:8787

# ---------- WhatsApp 配置（预留，后续扩展） ----------
# WA_BUSINESS_API_URL=
# WA_BUSINESS_API_TOKEN=

# ---------- 邮件配置（预留，后续扩展） ----------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
