{
  "name": "warungscout",
  "version": "1.0.0",
  "description": "🏪 印尼 Warung 智能评分与销售导航系统",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler deploy --env preview",
    "wrangler": "wrangler",
    "db:init": "wrangler d1 execute warungscout_db --file=./migrations/init.sql",
    "db:init:local": "wrangler d1 execute warungscout_db --local --file=./migrations/init.sql",
    "db:migrate": "wrangler d1 migrations apply warungscout_db",
    "db:preview": "wrangler d1 execute warungscout_db_preview --file=./migrations/init.sql",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "zustand": "^5.0.1",
    "@tanstack/react-query": "^5.59.20",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "class-variance-authority": "^0.7.0",
    "lucide-react": "^0.460.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^3.87.0",
    "tailwindcss": "^3.4.14",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "@types/node": "^22.8.6",
    "eslint": "^9.14.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vfvincentwong2026/warungscout.git"
  },
  "keywords": [
    "indonesia",
    "warung",
    "lead-scoring",
    "sales-navigation",
    "google-maps-scraper",
    "cloudflare-workers"
  ],
  "author": "vfvincentwong2026",
  "license": "MIT"
}
